# Safety: both flags are required for any exchange write. Keep false until both PoCs pass.
# 这是实盘运行的.env的配置
DRY_RUN=false
LIVE_TRADING_ACK=true
POC_VERIFIED=true
DATABASE_URL=sqlite:///./arbitrage.db
LOG_LEVEL=INFO

WINDOW_SIZE=100000
MIN_ENTRY_SAMPLES=10000
MAX_QUOTE_AGE_MS=1500
MAX_QUOTE_SKEW_MS=500
EXECUTION_TIMEOUT_MS=10000
MAX_ORDER_SLIPPAGE_BPS=20
POSITION_TOLERANCE=0.00000001
RISK_DATA_TIMEOUT_SECONDS=120
RISK_CHECK_INTERVAL_SECONDS=60
TELEGRAM_STATUS_INTERVAL_SECONDS=1800
ENABLE_REAL_MARKET_STREAMS=true

# Lighter (official mainnet defaults; use testnet URLs for PoC)
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_WS_URL=wss://mainnet.zklighter.elliot.ai/stream
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=
LIGHTER_API_PRIVATE_KEY=

# POPDEX official mainnet defaults. Testnet chain id is 34952.
POPDEX_API_URL=https://api.popdex.xyz
POPDEX_WS_URL=wss://ws.popdex.xyz/v1/ws/public
POPDEX_RPC_URL=https://api.popdex.xyz/api/v1/web3/rpc
POPDEX_RPC_POOL_LIMIT=20
POPDEX_RPC_KEEPALIVE_SECONDS=120
POPDEX_GAS_LIMIT_CACHE_SECONDS=3600
POPDEX_GAS_LIMIT_SAFETY_MULTIPLIER=1.20
POPDEX_CHAIN_ID=2184
POPDEX_ORDER_CONTRACT=0x0000000000000000000000000000000000001000
POPDEX_ACCOUNT_ADDRESS=
POPDEX_SIGNER_PRIVATE_KEY=
POPDEX_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
POPDEX_BUILDER_FEE_RATE=0

# The current official Order page does not publish enum numeric values for these fields.
# Populate only after a testnet PoC has recorded and verified the exact values.
POPDEX_ENUM_ORDER_TYPE_MARKET=1
POPDEX_ENUM_SIDE_BUY=0
POPDEX_ENUM_SIDE_SELL=1
POPDEX_ENUM_TIME_IN_FORCE_IOC=
POPDEX_SLIPPAGE_ENCODING=ratio_1e18

# Optional notifications. Secrets are read from environment only and never persisted/logged.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
